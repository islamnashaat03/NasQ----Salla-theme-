<section data-testid="store-home-custom-testimonials" class="nasq-testimonials s-block">
  <div class="container overflow-hidden">
    <header class="nasq-section-heading">
      <h2>{{ component.title }}</h2>
      {% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}
    </header>

    <salla-slider
      id="nasq-testimonials-{{ position }}"
      type="carousel"
      pagination
      auto-play
      {{ component.items|length > 1 ? '' : 'show-controls="false"' }}>
      <div slot="items">
        {% for index, item in component.items %}
          <article class="swiper-slide nasq-testimonial-card">
            <i class="sicon-quote-open nasq-testimonial-card__quote" aria-hidden="true"></i>
            <salla-rating-stars size="small" value="{{ item.stars|default(5) }}"></salla-rating-stars>
            <blockquote>{{ item.text }}</blockquote>
            <footer class="nasq-testimonial-card__customer">
              {% if item.avatar %}
                <img src="{{ item.avatar }}" loading="lazy" width="56" height="56" alt="{{ item.name|trim ? item.name : 'testimonial-' ~ index }}">
              {% endif %}
              <strong>{{ item.name }}</strong>
            </footer>
          </article>
        {% endfor %}
      </div>
    </salla-slider>
  </div>
</section>
