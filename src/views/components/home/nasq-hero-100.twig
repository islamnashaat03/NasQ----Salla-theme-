{% set background_type = component.background_type ?: 'image' %}
{% set background_type = background_type.value is defined ? background_type.value : background_type %}
{% set background_type = background_type is iterable ? background_type|first : background_type %}
{% set background_type = background_type.value is defined ? background_type.value : background_type %}
{% set background_type = background_type ?: 'image' %}
{% set vertical_align = component.vertical_align ?: 'center' %}
{% set vertical_align = vertical_align.value is defined ? vertical_align.value : vertical_align %}
{% set vertical_align = vertical_align is iterable ? vertical_align|first : vertical_align %}
{% set vertical_align = vertical_align.value is defined ? vertical_align.value : vertical_align %}
{% set vertical_align = vertical_align ?: 'center' %}
{% set content_align = component.content_align ?: 'center' %}
{% set content_align = content_align.value is defined ? content_align.value : content_align %}
{% set content_align = content_align is iterable ? content_align|first : content_align %}
{% set content_align = content_align.value is defined ? content_align.value : content_align %}
{% set content_align = content_align ?: 'center' %}
{% set overlay_opacity = component.overlay_opacity is defined and component.overlay_opacity is not null ? component.overlay_opacity : 40 %}
<section class="nasq-hero100 nasq-hero100--{{ background_type }} nasq-hero100--h-{{ vertical_align }} nasq-hero100--x-{{ content_align }}" style="--hero-height:{{ component.height ?: 720 }}px;--hero-mobile-height:{{ component.mobile_height ?: 560 }}px;--hero-color:{{ component.text_color ?: '#ffffff' }};--hero-overlay:{{ component.overlay_color ?: '#000000' }};--hero-opacity:{{ overlay_opacity / 100 }};--hero-content-width:{{ component.content_width ?: 760 }}px">
  <div class="nasq-hero100__media"{% if background_type not in ['image-slider', 'video-slider'] %} aria-hidden="true"{% endif %}>
    {% if background_type == 'video' and component.background_video %}
      <video playsinline muted {{ component.autoplay ? 'autoplay' : '' }} {{ component.loop ? 'loop' : '' }} poster="{{ component.video_poster }}"><source src="{{ component.background_video }}"></video>
    {% elseif background_type == 'image-slider' and component.image_slides %}
      <salla-slider id="nasq-hero-images-{{ position }}" type="carousel" slides-per-view="1" pagination {{ component.autoplay ? 'auto-play' : '' }} {{ component.loop ? 'loop' : '' }}><div slot="items">{% for slide in component.image_slides %}<div class="swiper-slide"><img src="{{ slide.image }}" alt="{{ slide.alt }}" loading="{{ loop.first ? 'eager' : 'lazy' }}"></div>{% endfor %}</div></salla-slider>
    {% elseif background_type == 'video-slider' and component.video_slides %}
      <salla-slider id="nasq-hero-videos-{{ position }}" type="carousel" slides-per-view="1" pagination {{ component.autoplay ? 'auto-play' : '' }} {{ component.loop ? 'loop' : '' }}><div slot="items">{% for slide in component.video_slides %}<div class="swiper-slide"><video playsinline muted {{ component.autoplay ? 'autoplay' : '' }} {{ component.loop ? 'loop' : '' }} poster="{{ slide.poster }}"><source src="{{ slide.video }}"></video></div>{% endfor %}</div></salla-slider>
    {% elseif component.background_image %}<img src="{{ component.background_image }}" alt="" loading="eager">{% endif %}
  </div>
  <div class="nasq-hero100__overlay"></div>
  <div class="nasq-container nasq-hero100__inner"><div class="nasq-hero100__content">
    {% if component.eyebrow %}<span class="nasq-hero100__eyebrow">{{ component.eyebrow }}</span>{% endif %}
    <h1>{{ component.title }}</h1>
    {% if component.description %}<p>{{ component.description }}</p>{% endif %}
    {% if component.buttons %}<div class="nasq-hero100__buttons">{% for button in component.buttons %}{% set button_style = button.style %}
{% set button_style = button_style.value is defined ? button_style.value : button_style %}
{% set button_style = button_style is iterable ? button_style|first : button_style %}
{% set button_style = button_style.value is defined ? button_style.value : button_style %}
{% set button_style = button_style ?: 'solid' %}<a class="nasq-hero100__button nasq-hero100__button--{{ button_style ?: 'solid' }}" href="{{ button.url }}">{{ button.label }}</a>{% endfor %}</div>{% endif %}
  </div></div>
</section>
