<section class="nasq-banners nasq-banners--slider s-block">
  <div class="container overflow-hidden">
    {% if component.title or component.subtitle %}
      <header class="nasq-section-heading">
        {% if component.title %}<h2>{{ component.title }}</h2>{% endif %}
        {% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}
      </header>
    {% endif %}
    <salla-slider id="nasq-banner-slider-{{ position }}" type="carousel" auto-play pagination static-when-single>
      <div slot="items">
        {% for index, banner in component.banners %}
          <div class="swiper-slide">
            <a class="nasq-banner-card" href="{{ banner.url|default('#') }}" aria-label="{{ banner.title|default('banner-' ~ index) }}">
              <img src="{{ banner.image }}" loading="lazy" width="1600" height="640" alt="{{ banner.title|default(store.name) }}">
              {% if banner.title or banner.text %}
                <span class="nasq-banner-card__content">
                  {% if banner.title %}<strong>{{ banner.title }}</strong>{% endif %}
                  {% if banner.text %}<small>{{ banner.text }}</small>{% endif %}
                </span>
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>
    </salla-slider>
  </div>
</section>
