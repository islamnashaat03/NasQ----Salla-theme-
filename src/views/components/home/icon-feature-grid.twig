<section class="nasq-feature-grid s-block">
  <div class="container">
    {% if component.title %}<header class="nasq-section-heading"><h2>{{ component.title }}</h2></header>{% endif %}
    <div class="nasq-feature-grid__items">
      {% for item in component.items %}
        {% if item.url %}<a href="{{ item.url }}" class="nasq-feature-tile">{% else %}<div class="nasq-feature-tile">{% endif %}
          <i class="{{ item.icon }}" aria-hidden="true"></i><div><strong>{{ item.title }}</strong>{% if item.text %}<p>{{ item.text }}</p>{% endif %}</div>
        {% if item.url %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
