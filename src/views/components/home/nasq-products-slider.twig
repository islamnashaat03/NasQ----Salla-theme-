{% set selected_ids = component.products|default([])|map(product => product.id is defined ? product.id : product) %}
<section class="nasq-products-section nasq-products-section--slider s-block" aria-labelledby="nasq-products-slider-{{ position }}">
  <div class="container overflow-hidden">
    <header class="nasq-section-heading">
      <h2 id="nasq-products-slider-{{ position }}">{{ component.title }}</h2>
      {% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}
    </header>
    {% if selected_ids|length %}
      <salla-products-slider
        data-testid="store-home-nasq-products-slider"
        source="selected"
        source-value="{{ selected_ids|json_encode|e('html_attr') }}"
        limit="{{ selected_ids|length }}">
      </salla-products-slider>
    {% endif %}
  </div>
</section>
