<section class="nasq-lookbook s-block" aria-labelledby="lookbook-{{ position }}">
  <div class="container">
    <div class="nasq-lookbook__grid">
      <figure class="nasq-lookbook__visual">
        <img src="{{ component.image }}" loading="lazy" decoding="async" width="900" height="1125" alt="{{ component.title }}">
      </figure>
      <div class="nasq-lookbook__content">
        <span class="nasq-eyebrow">{{ component.subtitle }}</span>
        <h2 id="lookbook-{{ position }}">{{ component.title }}</h2>
        {% if component.products|length %}
          <div class="nasq-lookbook__products">
            <salla-products-list source="selected" source-value="{{ component.products|map(p => p.id)|join(',') }}" limit="4"></salla-products-list>
          </div>
        {% endif %}
        {% if component.link %}
          <a class="nasq-text-link" href="{{ component.link }}">{{ component.link_text }} <i class="sicon-arrow-left"></i></a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
